## Copie este arquivo para ".env" e preencha com valores reais (não versionar o .env).

# Connection string do PostgreSQL (Supabase ou Render PostgreSQL)
# Exemplo Supabase: postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Exemplo Render:   postgresql://usuario:SENHA@dpg-xxxxxxx-a.oregon-postgres.render.com/nomedb
DATABASE_URL="postgresql://usuario:senha@host:5432/devshowcase?schema=public"

# Porta usada localmente (em produção o PaaS injeta a variável PORT automaticamente)
PORT=3000
