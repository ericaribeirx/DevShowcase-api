{
  "info": {
    "name": "DevShowcase API",
    "description": "Coleção com todos os endpoints implementados na DevShowcase API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Root",
      "item": [
        {
          "name": "GET / (health check)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Profiles",
      "item": [
        {
          "name": "POST /api/profiles (criar perfil)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Erica Souza\",\n  \"email\": \"erica@teste.com\",\n  \"bio\": \"Estudante de Sistemas para Internet\"\n}"
            },
            "url": "{{baseUrl}}/api/profiles"
          }
        },
        {
          "name": "POST /api/profiles (erro de validação)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"email-invalido\"\n}"
            },
            "url": "{{baseUrl}}/api/profiles"
          }
        },
        {
          "name": "GET /api/profiles/:id (encontrado)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profiles/1"
          }
        },
        {
          "name": "GET /api/profiles/:id (não encontrado - 404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profiles/999"
          }
        }
      ]
    },
    {
      "name": "Technologies",
      "item": [
        {
          "name": "POST /api/technologies (criar tecnologia)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Node.js\"\n}"
            },
            "url": "{{baseUrl}}/api/technologies"
          }
        },
        {
          "name": "POST /api/technologies (erro de validação)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/technologies"
          }
        },
        {
          "name": "GET /api/technologies (listar todas)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/technologies"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "POST /api/projects (criar projeto)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"DevShowcase\",\n  \"description\": \"API de portfolio de projetos\",\n  \"url\": \"https://github.com/erica/devshowcase\",\n  \"profileId\": 1,\n  \"technologyIds\": [1, 2]\n}"
            },
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "POST /api/projects (erro de validação)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"url\": \"url-invalida\",\n  \"profileId\": 1,\n  \"technologyIds\": \"nao-array\"\n}"
            },
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "GET /api/projects (listar todos, paginado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /api/projects (filtrar por tecnologia)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?technology=Node.js&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                { "key": "technology", "value": "Node.js" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "PUT /api/projects/:id/upvote (incrementar curtidas)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/projects/1/upvote"
          }
        }
      ]
    },
    {
      "name": "Feedbacks",
      "item": [
        {
          "name": "POST /api/projects/:id/feedbacks (criar feedback)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Maria\",\n  \"comment\": \"Projeto muito bem estruturado!\",\n  \"rating\": 5\n}"
            },
            "url": "{{baseUrl}}/api/projects/1/feedbacks"
          }
        },
        {
          "name": "POST /api/projects/:id/feedbacks (erro de validação - nota fora do intervalo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Maria\",\n  \"comment\": \"Muito bom\",\n  \"rating\": 9\n}"
            },
            "url": "{{baseUrl}}/api/projects/1/feedbacks"
          }
        },
        {
          "name": "POST /api/projects/:id/feedbacks (projeto não encontrado - 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Maria\",\n  \"comment\": \"Muito bom\",\n  \"rating\": 4\n}"
            },
            "url": "{{baseUrl}}/api/projects/999/feedbacks"
          }
        }
      ]
    },
    {
      "name": "Docs",
      "item": [
        {
          "name": "GET /api-docs (Swagger UI)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api-docs/"
          }
        }
      ]
    }
  ]
}
